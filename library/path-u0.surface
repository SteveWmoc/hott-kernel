; First checked HoTT path algebra, specialized explicitly to universe 0.
(surface 0 1)
(module PathU0)

(transparent path_inverse
  (pi A (universe 0)
    (pi x (ref A)
      (pi y (ref A)
        (pi p (id (ref A) (ref x) (ref y))
          (id (ref A) (ref y) (ref x))))))
  (lam A
    (lam x
      (lam y
        (lam p
          (j
            (ref A)
            (ref x)
            (ann
              (lam endpoint
                (lam path
                  (id (ref A) (ref endpoint) (ref x))))
              (pi endpoint (ref A)
                (pi path (id (ref A) (ref x) (ref endpoint))
                  (universe 0))))
            (refl (ref x))
            (ref y)
            (ref p)))))))

(transparent path_inverse_refl
  (pi A (universe 0)
    (pi x (ref A)
      (id
        (id (ref A) (ref x) (ref x))
        (app
          (app
            (app
              (app (ref path_inverse) (ref A))
              (ref x))
            (ref x))
          (refl (ref x)))
        (refl (ref x)))))
  (lam A
    (lam x
      (refl (refl (ref x))))))

; Concatenation eliminates the second path, so p · refl computes to p.
(transparent path_concat
  (pi A (universe 0)
    (pi x (ref A)
      (pi y (ref A)
        (pi z (ref A)
          (pi p (id (ref A) (ref x) (ref y))
            (pi q (id (ref A) (ref y) (ref z))
              (id (ref A) (ref x) (ref z))))))))
  (lam A
    (lam x
      (lam y
        (lam z
          (lam p
            (lam q
              (j
                (ref A)
                (ref y)
                (ann
                  (lam endpoint
                    (lam path
                      (id (ref A) (ref x) (ref endpoint))))
                  (pi endpoint (ref A)
                    (pi path (id (ref A) (ref y) (ref endpoint))
                      (universe 0))))
                (ref p)
                (ref z)
                (ref q)))))))))

(transparent path_concat_right_refl
  (pi A (universe 0)
    (pi x (ref A)
      (pi y (ref A)
        (pi p (id (ref A) (ref x) (ref y))
          (id
            (id (ref A) (ref x) (ref y))
            (app
              (app
                (app
                  (app
                    (app
                      (app (ref path_concat) (ref A))
                      (ref x))
                    (ref y))
                  (ref y))
                (ref p))
              (refl (ref y)))
            (ref p))))))
  (lam A
    (lam x
      (lam y
        (lam p
          (refl (ref p)))))))
