                (lam point (app (ref g) (app (ref f) (ref point)))))
              (lam point (ref point)))
            (pi retraction
              (app
                (app
                  (app (app (ref homotopy) (ref B)) (lam point (ref B)))
                  (lam point (app (ref f) (app (ref g) (ref point)))))
                (lam point (ref point)))
              (app (app (app (ref quasi_inverse) (ref A)) (ref B)) (ref f))))))))
  (lam A
    (lam B
      (lam f
        (lam g
          (lam section
            (lam retraction (pair (ref g) (pair (ref section) (ref retraction))))))))))

(transparent quasi_inverse_map
  (pi A
