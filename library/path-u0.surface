; Dependent pointwise homotopy and its reflexive, symmetric, transitive laws.

(transparent homotopy
  (pi A
    (universe 0)
    (pi P
      (pi x (ref A) (universe 0))
      (pi f
        (pi x (ref A) (app (ref P) (ref x)))
        (pi g (pi x (ref A) (app (ref P) (ref x))) (universe 0)))))
  (lam A
    (lam P
      (lam f
        (lam g
          (pi x
            (ref A)
            (id (app (ref P) (ref x)) (app (ref f) (ref x)) (app (ref g) (ref x)))))))))

(transparent homotopy_refl
  (pi A
    (universe 0)
    (pi P
      (pi x (ref A) (universe 0))
      (pi f
