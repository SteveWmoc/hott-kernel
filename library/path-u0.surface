; First checked HoTT path algebra, specialized explicitly to universe 0.
(surface 0 1)
(module PathU0)

(transparent path_inverse
  (pi A (universe 0)
    (pi x (ref A)
      (pi y (ref A)
        (pi p (id (ref A) (ref x) (ref y))
          (id (ref A) (ref y) (ref x))))))
  (lam A
    (lam x
      (lam y
        (lam p
          (j
            (ref A)
            (ref x)
            (ann
              (lam endpoint
                (lam path
                  (id (ref A) (ref endpoint) (ref x))))
              (pi endpoint (ref A)
                (pi path (id (ref A) (ref x) (ref endpoint))
                  (universe 0))))
            (refl (ref x))
            (ref y)
            (ref p)))))))

(transparent path_inverse_refl
  (pi A (universe 0)
    (pi x (ref A)
      (id
        (id (ref A) (ref x) (ref x))
        (app
          (app
            (app
              (app (ref path_inverse) (ref A))
              (ref x))
            (ref x))
          (refl (ref x)))
        (refl (ref x)))))
  (lam A
    (lam x
      (refl (refl (ref x))))))

; Concatenation eliminates the second path, so p · refl computes to p.
(transparent path_concat
  (pi A (universe 0)
    (pi x (ref A)
      (pi y (ref A)
        (pi z (ref A)
          (pi p (id (ref A) (ref x) (ref y))
            (pi q (id (ref A) (ref y) (ref z))
              (id (ref A) (ref x) (ref z))))))))
  (lam A
    (lam x
      (lam y
        (lam z
          (lam p
            (lam q
              (j
                (ref A)
                (ref y)
                (ann
                  (lam endpoint
                    (lam path
                      (id (ref A) (ref x) (ref endpoint))))
                  (pi endpoint (ref A)
                    (pi path (id (ref A) (ref y) (ref endpoint))
                      (universe 0))))
                (ref p)
                (ref z)
                (ref q)))))))))

(transparent path_concat_right_refl
  (pi A (universe 0)
    (pi x (ref A)
      (pi y (ref A)
        (pi p (id (ref A) (ref x) (ref y))
          (id
            (id (ref A) (ref x) (ref y))
            (app
              (app
                (app
                  (app
                    (app
                      (app (ref path_concat) (ref A))
                      (ref x))
                    (ref y))
                  (ref y))
                (ref p))
              (refl (ref y)))
            (ref p))))))
  (lam A
    (lam x
      (lam y
        (lam p
          (refl (ref p)))))))

; Left unit is propositional rather than judgmental for this concat orientation.
(transparent path_concat_left_refl
  (pi A (universe 0)
    (pi x (ref A)
      (pi y (ref A)
        (pi p (id (ref A) (ref x) (ref y))
          (id
            (id (ref A) (ref x) (ref y))
            (app
              (app
                (app
                  (app
                    (app
                      (app (ref path_concat) (ref A))
                      (ref x))
                    (ref x))
                  (ref y))
                (refl (ref x)))
              (ref p))
            (ref p))))))
  (lam A
    (lam x
      (lam y
        (lam p
          (j
            (ref A)
            (ref x)
            (ann
              (lam endpoint
                (lam path
                  (id
                    (id (ref A) (ref x) (ref endpoint))
                    (app
                      (app
                        (app
                          (app
                            (app
                              (app (ref path_concat) (ref A))
                              (ref x))
                            (ref x))
                          (ref endpoint))
                        (refl (ref x)))
                      (ref path))
                    (ref path))))
              (pi endpoint (ref A)
                (pi path (id (ref A) (ref x) (ref endpoint))
                  (universe 0))))
            (refl (refl (ref x)))
            (ref y)
            (ref p)))))))

; Associativity is proved by eliminating the third path.
(transparent path_concat_assoc
  (pi A (universe 0)
    (pi x (ref A)
      (pi y (ref A)
        (pi z (ref A)
          (pi w (ref A)
            (pi p (id (ref A) (ref x) (ref y))
              (pi q (id (ref A) (ref y) (ref z))
                (pi r (id (ref A) (ref z) (ref w))
                  (id
                    (id (ref A) (ref x) (ref w))
                    (app
                      (app
                        (app
                          (app
                            (app
                              (app (ref path_concat) (ref A))
                              (ref x))
                            (ref z))
                          (ref w))
                        (app
                          (app
                            (app
                              (app
                                (app
                                  (app (ref path_concat) (ref A))
                                  (ref x))
                                (ref y))
                              (ref z))
                            (ref p))
                          (ref q)))
                      (ref r))
                    (app
                      (app
                        (app
                          (app
                            (app
                              (app (ref path_concat) (ref A))
                              (ref x))
                            (ref y))
                          (ref w))
                        (ref p))
                      (app
                        (app
                          (app
                            (app
                              (app
                                (app (ref path_concat) (ref A))
                                (ref y))
                              (ref z))
                            (ref w))
                          (ref q))
                        (ref r))))))))))))
  (lam A
    (lam x
      (lam y
        (lam z
          (lam w
            (lam p
              (lam q
                (lam r
                  (j
                    (ref A)
                    (ref z)
                    (ann
                      (lam endpoint
                        (lam path
                          (id
                            (id (ref A) (ref x) (ref endpoint))
                            (app
                              (app
                                (app
                                  (app
                                    (app
                                      (app (ref path_concat) (ref A))
                                      (ref x))
                                    (ref z))
                                  (ref endpoint))
                                (app
                                  (app
                                    (app
                                      (app
                                        (app
                                          (app (ref path_concat) (ref A))
                                          (ref x))
                                        (ref y))
                                      (ref z))
                                    (ref p))
                                  (ref q)))
                              (ref path))
                            (app
                              (app
                                (app
                                  (app
                                    (app
                                      (app (ref path_concat) (ref A))
                                      (ref x))
                                    (ref y))
                                  (ref endpoint))
                                (ref p))
                              (app
                                (app
                                  (app
                                    (app
                                      (app
                                        (app (ref path_concat) (ref A))
                                        (ref y))
                                      (ref z))
                                    (ref endpoint))
                                  (ref q))
                                (ref path))))))
                      (pi endpoint (ref A)
                        (pi path (id (ref A) (ref z) (ref endpoint))
                          (universe 0))))
                    (refl
                      (app
                        (app
                          (app
                            (app
                              (app
                                (app (ref path_concat) (ref A))
                                (ref x))
                              (ref y))
                            (ref z))
                          (ref p))
                        (ref q)))
                    (ref w)
                    (ref r)))))))))))

; Transport eliminates the path, carrying an element along the family P.
(transparent transport
  (pi A (universe 0)
    (pi P (pi point (ref A) (universe 0))
      (pi x (ref A)
        (pi y (ref A)
          (pi p (id (ref A) (ref x) (ref y))
            (pi u (app (ref P) (ref x))
              (app (ref P) (ref y))))))))
  (lam A
    (lam P
      (lam x
        (lam y
          (lam p
            (lam u
              (j
                (ref A)
                (ref x)
                (ann
                  (lam endpoint
                    (lam path
                      (app (ref P) (ref endpoint))))
                  (pi endpoint (ref A)
                    (pi path (id (ref A) (ref x) (ref endpoint))
                      (universe 0))))
                (ref u)
                (ref y)
                (ref p)))))))))

; Transport along reflexivity computes judgmentally to the original element.
(transparent transport_refl
  (pi A (universe 0)
    (pi P (pi point (ref A) (universe 0))
      (pi x (ref A)
        (pi u (app (ref P) (ref x))
          (id
            (app (ref P) (ref x))
            (app
              (app
                (app
                  (app
                    (app
                      (app (ref transport) (ref A))
                      (ref P))
                    (ref x))
                  (ref x))
                (refl (ref x)))
              (ref u))
            (ref u))))))
  (lam A
    (lam P
      (lam x
        (lam u
          (refl (ref u)))))))

; Functions act on paths by identity elimination.
(transparent ap
  (pi A (universe 0)
    (pi B (universe 0)
      (pi f (pi point (ref A) (ref B))
        (pi x (ref A)
          (pi y (ref A)
            (pi p (id (ref A) (ref x) (ref y))
              (id
                (ref B)
                (app (ref f) (ref x))
                (app (ref f) (ref y)))))))))
  (lam A
    (lam B
      (lam f
        (lam x
          (lam y
            (lam p
              (j
                (ref A)
                (ref x)
                (ann
                  (lam endpoint
                    (lam path
                      (id
                        (ref B)
                        (app (ref f) (ref x))
                        (app (ref f) (ref endpoint)))))
                  (pi endpoint (ref A)
                    (pi path (id (ref A) (ref x) (ref endpoint))
                      (universe 0))))
                (refl (app (ref f) (ref x)))
                (ref y)
                (ref p)))))))))

; ap sends reflexivity to reflexivity judgmentally.
(transparent ap_refl
  (pi A (universe 0)
    (pi B (universe 0)
      (pi f (pi point (ref A) (ref B))
        (pi x (ref A)
          (id
            (id
              (ref B)
              (app (ref f) (ref x))
              (app (ref f) (ref x)))
            (app
              (app
                (app
                  (app
                    (app
                      (app (ref ap) (ref A))
                      (ref B))
                    (ref f))
                  (ref x))
                (ref x))
              (refl (ref x)))
            (refl (app (ref f) (ref x))))))))
  (lam A
    (lam B
      (lam f
        (lam x
          (refl (refl (app (ref f) (ref x)))))))))

; ap preserves path concatenation propositionally.
(transparent ap_concat
  (pi A
      (universe 0)
      (pi B
        (universe 0)
        (pi f
          (pi point (ref A) (ref B))
          (pi x
            (ref A)
            (pi y
              (ref A)
              (pi z
                (ref A)
                (pi p
                  (id (ref A) (ref x) (ref y))
                  (pi q
                    (id (ref A) (ref y) (ref z))
                    (id
                      (id (ref B) (app (ref f) (ref x)) (app (ref f) (ref z)))
                      (app
                        (app
                          (app (app (app (app (ref ap) (ref A)) (ref B)) (ref f)) (ref x))
                          (ref z))
                        (app
                          (app
                            (app
                              (app (app (app (ref path_concat) (ref A)) (ref x)) (ref y))
                              (ref z))
                            (ref p))
                          (ref q)))
                      (app
                        (app
                          (app
                            (app
                              (app (app (ref path_concat) (ref B)) (app (ref f) (ref x)))
                              (app (ref f) (ref y)))
                            (app (ref f) (ref z)))
                          (app
                            (app
                              (app (app (app (app (ref ap) (ref A)) (ref B)) (ref f)) (ref x))
                              (ref y))
                            (ref p)))
                        (app
                          (app
                            (app (app (app (app (ref ap) (ref A)) (ref B)) (ref f)) (ref y))
                            (ref z))
                          (ref q))))))))))))
  (lam A
      (lam B
        (lam f
          (lam x
            (lam y
              (lam z
                (lam p
                  (lam q
                    (j
                      (ref A)
                      (ref y)
                      (ann
                        (lam endpoint
                          (lam path
                            (id
                              (id (ref B) (app (ref f) (ref x)) (app (ref f) (ref endpoint)))
                              (app
                                (app
                                  (app
                                    (app (app (app (ref ap) (ref A)) (ref B)) (ref f))
                                    (ref x))
                                  (ref endpoint))
                                (app
                                  (app
                                    (app
                                      (app
                                        (app (app (ref path_concat) (ref A)) (ref x))
                                        (ref y))
                                      (ref endpoint))
                                    (ref p))
                                  (ref path)))
                              (app
                                (app
                                  (app
                                    (app
                                      (app
                                        (app (ref path_concat) (ref B))
                                        (app (ref f) (ref x)))
                                      (app (ref f) (ref y)))
                                    (app (ref f) (ref endpoint)))
                                  (app
                                    (app
                                      (app
                                        (app (app (app (ref ap) (ref A)) (ref B)) (ref f))
                                        (ref x))
                                      (ref y))
                                    (ref p)))
                                (app
                                  (app
                                    (app
                                      (app (app (app (ref ap) (ref A)) (ref B)) (ref f))
                                      (ref y))
                                    (ref endpoint))
                                  (ref path))))))
                        (pi endpoint
                          (ref A)
                          (pi path (id (ref A) (ref y) (ref endpoint)) (universe 0))))
                      (refl
                        (app
                          (app
                            (app (app (app (app (ref ap) (ref A)) (ref B)) (ref f)) (ref x))
                            (ref y))
                          (ref p)))
                      (ref z)
                      (ref q)))))))))))

; ap preserves path inversion propositionally.
(transparent ap_inverse
  (pi A
      (universe 0)
      (pi B
        (universe 0)
        (pi f
          (pi point (ref A) (ref B))
          (pi x
            (ref A)
            (pi y
              (ref A)
              (pi p
                (id (ref A) (ref x) (ref y))
                (id
                  (id (ref B) (app (ref f) (ref y)) (app (ref f) (ref x)))
                  (app
                    (app
                      (app (app (app (app (ref ap) (ref A)) (ref B)) (ref f)) (ref y))
                      (ref x))
                    (app (app (app (app (ref path_inverse) (ref A)) (ref x)) (ref y)) (ref p)))
                  (app
                    (app
                      (app (app (ref path_inverse) (ref B)) (app (ref f) (ref x)))
                      (app (ref f) (ref y)))
                    (app
                      (app
                        (app (app (app (app (ref ap) (ref A)) (ref B)) (ref f)) (ref x))
                        (ref y))
                      (ref p))))))))))
  (lam A
      (lam B
        (lam f
          (lam x
            (lam y
              (lam p
                (j
                  (ref A)
                  (ref x)
                  (ann
                    (lam endpoint
                      (lam path
                        (id
                          (id (ref B) (app (ref f) (ref endpoint)) (app (ref f) (ref x)))
                          (app
                            (app
                              (app
                                (app (app (app (ref ap) (ref A)) (ref B)) (ref f))
                                (ref endpoint))
                              (ref x))
                            (app
                              (app
                                (app (app (ref path_inverse) (ref A)) (ref x))
                                (ref endpoint))
                              (ref path)))
                          (app
                            (app
                              (app (app (ref path_inverse) (ref B)) (app (ref f) (ref x)))
                              (app (ref f) (ref endpoint)))
                            (app
                              (app
                                (app
                                  (app (app (app (ref ap) (ref A)) (ref B)) (ref f))
                                  (ref x))
                                (ref endpoint))
                              (ref path))))))
                    (pi endpoint
                      (ref A)
                      (pi path (id (ref A) (ref x) (ref endpoint)) (universe 0))))
                  (refl (refl (app (ref f) (ref x))))
                  (ref y)
                  (ref p)))))))))

; Path inversion is propositionally involutive.
(transparent path_inverse_involutive
  (pi A
      (universe 0)
      (pi x
        (ref A)
        (pi y
          (ref A)
          (pi p
            (id (ref A) (ref x) (ref y))
            (id
              (id (ref A) (ref x) (ref y))
              (app
                (app (app (app (ref path_inverse) (ref A)) (ref y)) (ref x))
                (app (app (app (app (ref path_inverse) (ref A)) (ref x)) (ref y)) (ref p)))
              (ref p))))))
  (lam A
      (lam x
        (lam y
          (lam p
            (j
              (ref A)
              (ref x)
              (ann
                (lam endpoint
                  (lam path
                    (id
                      (id (ref A) (ref x) (ref endpoint))
                      (app
                        (app (app (app (ref path_inverse) (ref A)) (ref endpoint)) (ref x))
                        (app
                          (app (app (app (ref path_inverse) (ref A)) (ref x)) (ref endpoint))
                          (ref path)))
                      (ref path))))
                (pi endpoint
                  (ref A)
                  (pi path (id (ref A) (ref x) (ref endpoint)) (universe 0))))
              (refl (refl (ref x)))
              (ref y)
              (ref p)))))))

; p followed by p inverse contracts at x.
(transparent path_concat_inverse_right
  (pi A
    (universe 0)
    (pi x
      (ref A)
      (pi y
        (ref A)
        (pi p
          (id (ref A) (ref x) (ref y))
          (id
            (id (ref A) (ref x) (ref x))
            (app
              (app
                (app
                  (app (app (app (ref path_concat) (ref A)) (ref x)) (ref y))
                  (ref x))
                (ref p))
              (app (app (app (app (ref path_inverse) (ref A)) (ref x)) (ref y)) (ref p)))
            (refl (ref x)))))))
  (lam A
    (lam x
      (lam y
        (lam p
          (j
            (ref A)
            (ref x)
            (ann
              (lam endpoint
                (lam path
                  (id
                    (id (ref A) (ref x) (ref x))
                    (app
                      (app
                        (app
                          (app
                            (app (app (ref path_concat) (ref A)) (ref x))
                            (ref endpoint))
                          (ref x))
                        (ref path))
                      (app
                        (app
                          (app (app (ref path_inverse) (ref A)) (ref x))
                          (ref endpoint))
                        (ref path)))
                    (refl (ref x)))))
              (pi endpoint
                (ref A)
                (pi path (id (ref A) (ref x) (ref endpoint)) (universe 0))))
            (refl (refl (ref x)))
            (ref y)
            (ref p)))))))

; p inverse followed by p contracts at y.
(transparent path_concat_inverse_left
  (pi A
    (universe 0)
    (pi x
      (ref A)
      (pi y
        (ref A)
        (pi p
          (id (ref A) (ref x) (ref y))
          (id
            (id (ref A) (ref y) (ref y))
            (app
              (app
                (app
                  (app (app (app (ref path_concat) (ref A)) (ref y)) (ref x))
                  (ref y))
                (app
                  (app (app (app (ref path_inverse) (ref A)) (ref x)) (ref y))
                  (ref p)))
              (ref p))
            (refl (ref y)))))))
  (lam A
    (lam x
      (lam y
        (lam p
          (j
            (ref A)
            (ref x)
            (ann
              (lam endpoint
                (lam path
                  (id
                    (id (ref A) (ref endpoint) (ref endpoint))
                    (app
                      (app
                        (app
                          (app
                            (app (app (ref path_concat) (ref A)) (ref endpoint))
                            (ref x))
                          (ref endpoint))
                        (app
                          (app
                            (app (app (ref path_inverse) (ref A)) (ref x))
                            (ref endpoint))
                          (ref path)))
                      (ref path))
                    (refl (ref endpoint)))))
              (pi endpoint
                (ref A)
                (pi path (id (ref A) (ref x) (ref endpoint)) (universe 0))))
            (refl (refl (ref x)))
            (ref y)
            (ref p)))))))

; Reversing concatenation reverses the order of the two paths.
(transparent path_inverse_concat
  (pi A
    (universe 0)
    (pi x
      (ref A)
      (pi y
        (ref A)
        (pi z
          (ref A)
          (pi p
            (id (ref A) (ref x) (ref y))
            (pi q
              (id (ref A) (ref y) (ref z))
              (id
                (id (ref A) (ref z) (ref x))
                (app
                  (app (app (app (ref path_inverse) (ref A)) (ref x)) (ref z))
                  (app
                    (app
                      (app
                        (app (app (app (ref path_concat) (ref A)) (ref x)) (ref y))
                        (ref z))
                      (ref p))
                    (ref q)))
                (app
                  (app
                    (app
                      (app (app (app (ref path_concat) (ref A)) (ref z)) (ref y))
                      (ref x))
                    (app
                      (app (app (app (ref path_inverse) (ref A)) (ref y)) (ref z))
                      (ref q)))
                  (app
                    (app (app (app (ref path_inverse) (ref A)) (ref x)) (ref y))
                    (ref p))))))))))
  (lam A
    (lam x
      (lam y
        (lam z
          (lam p
            (lam q
              (j
                (ref A)
                (ref y)
                (ann
                  (lam endpoint
                    (lam path
                      (id
                        (id (ref A) (ref endpoint) (ref x))
                        (app
                          (app
                            (app (app (ref path_inverse) (ref A)) (ref x))
                            (ref endpoint))
                          (app
                            (app
                              (app
                                (app
                                  (app (app (ref path_concat) (ref A)) (ref x))
                                  (ref y))
                                (ref endpoint))
                              (ref p))
                            (ref path)))
                        (app
                          (app
                            (app
                              (app
                                (app (app (ref path_concat) (ref A)) (ref endpoint))
                                (ref y))
                              (ref x))
                            (app
                              (app
                                (app (app (ref path_inverse) (ref A)) (ref y))
                                (ref endpoint))
                              (ref path)))
                          (app
                            (app (app (app (ref path_inverse) (ref A)) (ref x)) (ref y))
                            (ref p))))))
                  (pi endpoint
                    (ref A)
                    (pi path (id (ref A) (ref y) (ref endpoint)) (universe 0))))
                (app
                  (app
                    (app
                      (app (ref path_inverse) (id (ref A) (ref y) (ref x)))
                      (app
                        (app
                          (app
                            (app (app (app (ref path_concat) (ref A)) (ref y)) (ref y))
                            (ref x))
                          (refl (ref y)))
                        (app
                          (app (app (app (ref path_inverse) (ref A)) (ref x)) (ref y))
                          (ref p))))
                    (app
                      (app (app (app (ref path_inverse) (ref A)) (ref x)) (ref y))
                      (ref p)))
                  (app
                    (app
                      (app (app (ref path_concat_left_refl) (ref A)) (ref y))
                      (ref x))
                    (app
                      (app (app (app (ref path_inverse) (ref A)) (ref x)) (ref y))
                      (ref p))))
                (ref z)
                (ref q)))))))))

; Transport along concatenation agrees with successive transports.
(transparent transport_concat
  (pi A
    (universe 0)
    (pi P
      (pi point (ref A) (universe 0))
      (pi x
        (ref A)
        (pi y
          (ref A)
          (pi z
            (ref A)
            (pi p
              (id (ref A) (ref x) (ref y))
              (pi q
                (id (ref A) (ref y) (ref z))
                (pi u
                  (app (ref P) (ref x))
                  (id
                    (app (ref P) (ref z))
                    (app
                      (app
                        (app
                          (app (app (app (ref transport) (ref A)) (ref P)) (ref x))
                          (ref z))
                        (app
                          (app
                            (app
                              (app
                                (app (app (ref path_concat) (ref A)) (ref x))
                                (ref y))
                              (ref z))
                            (ref p))
                          (ref q)))
                      (ref u))
                    (app
                      (app
                        (app
                          (app (app (app (ref transport) (ref A)) (ref P)) (ref y))
                          (ref z))
                        (ref q))
                      (app
                        (app
                          (app
                            (app (app (app (ref transport) (ref A)) (ref P)) (ref x))
                            (ref y))
                          (ref p))
                        (ref u))))))))))))
  (lam A
    (lam P
      (lam x
        (lam y
          (lam z
            (lam p
              (lam q
