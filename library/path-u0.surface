                          (ref homotopy_fg)
                          (app
                            (app
                              (app
                                (app (app (ref quasi_inverse_map) (ref A)) (ref B))
                                (ref f))
                              (ref witness))
                            (ref point)))))
                    (app
                      (app
                        (app
                          (app (app (ref quasi_inverse_retraction) (ref A)) (ref B))
                          (ref f))
                        (ref witness))
                      (ref point))))))))))))

; Naturality of a homotopy: ap f p followed by H(y) equals H(x) followed by ap g p.
(transparent homotopy_naturality
  (pi A
    (universe 0)
    (pi B
      (universe 0)
      (pi f
        (pi point (ref A) (ref B))
        (pi g
          (pi point (ref A) (ref B))
          (pi homotopy_fg
            (app
              (app (app (app (ref homotopy) (ref A)) (lam point (ref B))) (ref f))
              (ref g))
            (pi x
              (ref A)
              (pi y
                (ref A)
                (pi p
                  (id (ref A) (ref x) (ref y))
                  (id
                    (id (ref B) (app (ref f) (ref x)) (app (ref g) (ref y)))
                    (app
                      (app
                        (app
                          (app
                            (app (app (ref path_concat) (ref B)) (app (ref f) (ref x)))
                            (app (ref f) (ref y)))
                          (app (ref g) (ref y)))
                        (app
                          (app
                            (app
                              (app (app (app (ref ap) (ref A)) (ref B)) (ref f))
                              (ref x))
                            (ref y))
                          (ref p)))
                      (app (ref homotopy_fg) (ref y)))
                    (app
                      (app
                        (app
                          (app
                            (app (app (ref path_concat) (ref B)) (app (ref f) (ref x)))
                            (app (ref g) (ref x)))
                          (app (ref g) (ref y)))
                        (app (ref homotopy_fg) (ref x)))
                      (app
                        (app
                          (app
                            (app (app (app (ref ap) (ref A)) (ref B)) (ref g))
                            (ref x))
                          (ref y))
                        (ref p))))))))))))
  (lam A
    (lam B
      (lam f
        (lam g
          (lam homotopy_fg
            (lam x
              (lam y
                (lam p
                  (j
                    (ref A)
                    (ref x)
                    (ann
                      (lam endpoint
                        (lam path
                          (id
                            (id
                              (ref B)
                              (app (ref f) (ref x))
                              (app (ref g) (ref endpoint)))
                            (app
                              (app
                                (app
                                  (app
                                    (app
                                      (app (ref path_concat) (ref B))
                                      (app (ref f) (ref x)))
                                    (app (ref f) (ref endpoint)))
                                  (app (ref g) (ref endpoint)))
                                (app
                                  (app
                                    (app
                                      (app (app (app (ref ap) (ref A)) (ref B)) (ref f))
                                      (ref x))
                                    (ref endpoint))
                                  (ref path)))
                              (app (ref homotopy_fg) (ref endpoint)))
                            (app
                              (app
                                (app
                                  (app
                                    (app
                                      (app (ref path_concat) (ref B))
                                      (app (ref f) (ref x)))
                                    (app (ref g) (ref x)))
                                  (app (ref g) (ref endpoint)))
                                (app (ref homotopy_fg) (ref x)))
                              (app
                                (app
                                  (app
                                    (app (app (app (ref ap) (ref A)) (ref B)) (ref g))
                                    (ref x))
                                  (ref endpoint))
                                (ref path))))))
                      (pi endpoint
                        (ref A)
                        (pi path (id (ref A) (ref x) (ref endpoint)) (universe 0))))
                    (app
                      (app
                        (app
                          (app (ref path_concat_left_refl) (ref B))
                          (app (ref f) (ref x)))
                        (app (ref g) (ref x)))
                      (app (ref homotopy_fg) (ref x)))
                    (ref y)
                    (ref p)))))))))))

; Function action on paths preserves identity functions and composition.
(transparent ap_identity
  (pi A
    (universe 0)
    (pi x
      (ref A)
      (pi y
        (ref A)
        (pi p
          (id (ref A) (ref x) (ref y))
          (id
            (id (ref A) (ref x) (ref y))
            (app
              (app
                (app
                  (app (app (app (ref ap) (ref A)) (ref A)) (lam point (ref point)))
                  (ref x))
                (ref y))
              (ref p))
            (ref p))))))
  (lam A
    (lam x
      (lam y
        (lam p
          (j
            (ref A)
            (ref x)
            (ann
              (lam endpoint
                (lam path
                  (id
                    (id (ref A) (ref x) (ref endpoint))
                    (app
                      (app
                        (app
                          (app
                            (app (app (ref ap) (ref A)) (ref A))
                            (lam point (ref point)))
                          (ref x))
                        (ref endpoint))
                      (ref path))
                    (ref path))))
              (pi endpoint
                (ref A)
                (pi path (id (ref A) (ref x) (ref endpoint)) (universe 0))))
            (refl (refl (ref x)))
            (ref y)
            (ref p)))))))

