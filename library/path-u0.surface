                    (app
                      (app
                        (app
                          (app
                            (app (ref path_concat) (app (ref P) (ref x)))
                            (app (ref f) (ref x)))
                          (app (ref g) (ref x)))
                        (app (ref k) (ref x)))
                      (app (ref h) (ref x)))
                    (app (ref h2) (ref x))))))))))))

; Chosen quasi-inverse data for a fixed map; this is not a proposition-valued isEquiv.

(transparent quasi_inverse
  (pi A (universe 0) (pi B (universe 0) (pi f (pi point (ref A) (ref B)) (universe 0))))
  (lam A
    (lam B
      (lam f
        (sigma g
          (pi point (ref B) (ref A))
          (sigma section
            (app
              (app
                (app (app (ref homotopy) (ref A)) (lam point (ref A)))
                (lam point (app (ref g) (app (ref f) (ref point)))))
              (lam point (ref point)))
            (app
              (app
                (app (app (ref homotopy) (ref B)) (lam point (ref B)))
                (lam point (app (ref f) (app (ref g) (ref point)))))
              (lam point (ref point)))))))))

(transparent quasi_inverse_intro
  (pi A
    (universe 0)
    (pi B
      (universe 0)
      (pi f
        (pi point (ref A) (ref B))
