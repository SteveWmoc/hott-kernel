; Experimental noncommutative semiring theory for theorem discovery.
; All algebraic laws are explicit postulates. This file is untrusted Surface
; source and acquires no logical status until accepted by the Core checker.
(surface 0 1)
(module FinderSemiring)

(postulate A (universe 0))
(postulate zeroA (ref A))
(postulate oneA (ref A))

(postulate add
  (pi x (ref A)
    (pi y (ref A)
      (ref A))))

(postulate mul
  (pi x (ref A)
    (pi y (ref A)
      (ref A))))

(postulate add_assoc
  (pi x (ref A)
    (pi y (ref A)
      (pi z (ref A)
        (id
          (ref A)
          (app (app (ref add) (ref x))
            (app (app (ref add) (ref y)) (ref z)))
          (app
            (app (ref add)
              (app (app (ref add) (ref x)) (ref y)))
            (ref z)))))))

(postulate add_comm
  (pi x (ref A)
    (pi y (ref A)
      (id
        (ref A)
        (app (app (ref add) (ref x)) (ref y))
        (app (app (ref add) (ref y)) (ref x))))))

(postulate add_zero_right
  (pi x (ref A)
    (id
      (ref A)
      (ref x)
      (app (app (ref add) (ref x)) (ref zeroA)))))

(postulate mul_assoc
  (pi x (ref A)
    (pi y (ref A)
      (pi z (ref A)
        (id
          (ref A)
          (app (app (ref mul) (ref x))
            (app (app (ref mul) (ref y)) (ref z)))
          (app
            (app (ref mul)
              (app (app (ref mul) (ref x)) (ref y)))
            (ref z)))))))

(postulate mul_one_left
  (pi x (ref A)
    (id
      (ref A)
      (ref x)
      (app (app (ref mul) (ref oneA)) (ref x)))))

(postulate mul_one_right
  (pi x (ref A)
    (id
      (ref A)
      (ref x)
      (app (app (ref mul) (ref x)) (ref oneA)))))

(postulate left_distrib
  (pi x (ref A)
    (pi y (ref A)
      (pi z (ref A)
        (id
          (ref A)
          (app
            (app (ref add)
              (app (app (ref mul) (ref x)) (ref y)))
            (app (app (ref mul) (ref x)) (ref z)))
          (app
            (app (ref mul) (ref x))
            (app (app (ref add) (ref y)) (ref z))))))))

(postulate right_distrib
  (pi x (ref A)
    (pi y (ref A)
      (pi z (ref A)
        (id
          (ref A)
          (app
            (app (ref add)
              (app (app (ref mul) (ref x)) (ref z)))
            (app (app (ref mul) (ref y)) (ref z)))
          (app
            (app (ref mul)
              (app (app (ref add) (ref x)) (ref y)))
            (ref z)))))))

(postulate zero_mul
  (pi x (ref A)
    (id
      (ref A)
      (ref zeroA)
      (app (app (ref mul) (ref zeroA)) (ref x)))))

(postulate mul_zero
  (pi x (ref A)
    (id
      (ref A)
      (ref zeroA)
      (app (app (ref mul) (ref x)) (ref zeroA)))))


; Equality symmetry, transitivity, and function congruence are derived from J.
; They are transparent helper lemmas for the untrusted bounded proof search.

(transparent eq_symm
  (pi x (ref A)
    (pi y (ref A)
      (pi p (id (ref A) (ref x) (ref y))
        (id (ref A) (ref y) (ref x)))))
  (lam x
    (lam y
      (lam p
        (j
          (ref A)
          (ref x)
          (ann
            (lam endpoint
              (lam path
                (id (ref A) (ref endpoint) (ref x))))
            (pi endpoint (ref A)
              (pi path (id (ref A) (ref x) (ref endpoint))
                (universe 0))))
          (refl (ref x))
          (ref y)
          (ref p))))))

(transparent eq_trans
  (pi x (ref A)
    (pi y (ref A)
      (pi z (ref A)
        (pi p (id (ref A) (ref x) (ref y))
          (pi q (id (ref A) (ref y) (ref z))
            (id (ref A) (ref x) (ref z)))))))
  (lam x
    (lam y
      (lam z
        (lam p
          (lam q
            (j
              (ref A)
              (ref y)
              (ann
                (lam endpoint
                  (lam path
                    (id (ref A) (ref x) (ref endpoint))))
                (pi endpoint (ref A)
                  (pi path (id (ref A) (ref y) (ref endpoint))
                    (universe 0))))
              (ref p)
              (ref z)
              (ref q))))))))

(transparent eq_ap
  (pi f (pi point (ref A) (ref A))
    (pi x (ref A)
      (pi y (ref A)
        (pi p (id (ref A) (ref x) (ref y))
          (id
            (ref A)
            (app (ref f) (ref x))
            (app (ref f) (ref y)))))))
  (lam f
    (lam x
      (lam y
        (lam p
          (j
            (ref A)
            (ref x)
            (ann
              (lam endpoint
                (lam path
                  (id
                    (ref A)
                    (app (ref f) (ref x))
                    (app (ref f) (ref endpoint)))))
              (pi endpoint (ref A)
                (pi path (id (ref A) (ref x) (ref endpoint))
                  (universe 0))))
            (refl (app (ref f) (ref x)))
            (ref y)
            (ref p)))))))
