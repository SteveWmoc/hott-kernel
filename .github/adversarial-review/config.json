{
  "schema_version": 2,
  "max_changed_files": 200,
  "max_diff_chars": 600000,
  "max_changed_file_chars": 900000,
  "max_contract_chars": 400000,
  "contract_files": [
    "README.md",
    "CHARTER.md",
    ".github/workflows/ci.yml",
    "docs/core-v0.1.md",
    "docs/core-format.md",
    "docs/foundation-manifest-v0.1.md",
    "docs/audit-model.md",
    "docs/failure-classes.md",
    "docs/metatheory.md",
    "docs/implementability-review-v0.1.md",
    "docs/decisions/0001-proof-relevance.md",
    "docs/decisions/0002-universes.md",
    "docs/decisions/0003-judgmental-equality.md",
    "docs/decisions/0004-trusted-core.md",
    "docs/decisions/0005-implementation-language.md",
    "docs/decisions/0006-mixed-universe-formation.md",
    "docs/decisions/0007-core-interchange-format.md",
    "docs/decisions/0008-normalization-strategy.md",
    "docs/decisions/0009-freeze-core-format.md",
    "docs/decisions/0010-foundation-manifest.md",
    "docs/decisions/0011-failure-classes.md",
    "docs/decisions/0012-freeze-core-v0.1.md",
    "tests/specification/accepted.md",
    "tests/specification/rejected.md"
  ],
  "profile_routes": [
    {
      "profile": "foundational-consistency",
      "patterns": [
        "CHARTER.md",
        "docs/core-v0.1.md",
        "docs/metatheory.md",
        "docs/audit-model.md",
        "docs/failure-classes.md",
        "docs/decisions/**",
        "tests/specification/**"
      ]
    },
    {
      "profile": "kernel-soundness",
      "patterns": [
        "src/syntax.rs",
        "src/checker/**",
        "src/kernel/**",
        "src/conversion/**",
        "src/substitution/**",
        "src/normalization/**",
        "tests/conformance/**",
        "tests/kernel/**"
      ]
    },
    {
      "profile": "schema-encoding",
      "patterns": [
        "schemas/**",
        "docs/core-format.md",
        "docs/foundation-manifest-v0.1.md",
        "src/format/printer.rs",
        "tests/format/canonical/**",
        "tests/format/manifests/**",
        "tests/format/expected-hashes.json"
      ]
    },
    {
      "profile": "parser-boundary",
      "patterns": [
        "src/error.rs",
        "src/format/mod.rs",
        "src/format/parser.rs",
        "tests/format/malformed/**",
        "tests/format/noncanonical/**",
        "tests/format/invalid-judgment/**",
        "tests/format/unsupported/**"
      ]
    },
    {
      "profile": "ci-supply-chain",
      "patterns": [
        ".github/workflows/**",
        ".github/adversarial-review/**",
        "scripts/**",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml"
      ]
    }
  ]
}
